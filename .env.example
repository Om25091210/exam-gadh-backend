NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://examgadh:examgadh@localhost:5432/examgadh
# >= 32 random characters (openssl rand -base64 48)
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# Comma-separated OAuth client ids (web, android, ios) accepted as the ID token audience
GOOGLE_CLIENT_IDS=
# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOG_LEVEL=debug
