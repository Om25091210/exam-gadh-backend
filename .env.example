NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://examgadh:examgadh@localhost:5432/examgadh
# >= 32 random characters (openssl rand -base64 48)
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# Comma-separated OAuth client ids (web, android, ios) accepted as the ID token audience
GOOGLE_CLIENT_IDS=
# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOG_LEVEL=debug
# 32 random bytes, base64: encrypts admin TOTP secrets at rest (openssl rand -base64 32)
ADMIN_TOTP_KEY=
# Admin cookie is Secure in production; set false only when testing over plain http locally
ADMIN_COOKIE_SECURE=false
# S3 bucket for uploads (terraform output media_bucket) and the CloudFront domain that serves public/*
MEDIA_BUCKET=
MEDIA_CDN_DOMAIN=
AWS_REGION=ap-south-1
